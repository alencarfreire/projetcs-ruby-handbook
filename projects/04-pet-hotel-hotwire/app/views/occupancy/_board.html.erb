<%= turbo_frame_tag "occupancy" do %>
  <section class="occupancy-board">
    <header class="page-header">
      <div class="page-copy">
        <p class="eyebrow">Recepção</p>
        <h1>Quem está no hotel agora</h1>
        <p class="lede">Pets com check-in feito e ainda sem check-out. Check-out daqui atualiza o quadro — sem recarregar a página. Outra aba não vê: isso é o projeto 6.</p>
      </div>
      <p class="occupancy-count">
        <strong><%= @stays.size %></strong>
        <span><%= @stays.size == 1 ? "hospedado" : "hospedados" %></span>
      </p>
    </header>

    <% if @stays.empty? %>
      <p class="empty">Nenhum pet hospedado no momento. <%= link_to "Ver hospedagens", stays_path, data: { turbo_frame: "_top" } %>.</p>
    <% else %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Pet</th>
              <th scope="col">Dono</th>
              <th scope="col">Check-in</th>
              <th scope="col">Check-out</th>
              <th scope="col" class="num">Total</th>
              <th scope="col"><span class="visually-hidden">Ações</span></th>
            </tr>
          </thead>
          <tbody>
            <% @stays.each do |stay| %>
              <tr>
                <td class="pet-name"><%= link_to stay.pet.name, stay, data: { turbo_frame: "_top" } %></td>
                <td><%= stay.owner.name %></td>
                <td><%= l(stay.check_in) %></td>
                <td><%= l(stay.check_out) %></td>
                <td class="num"><%= format_money(stay.total_cents) %></td>
                <td class="cell-actions">
                  <%= button_to "Fazer check-out", check_out_stay_path(stay), method: :post %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
<% end %>
